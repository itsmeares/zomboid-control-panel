{
  "name": "better-zcp",
  "version": "2.0.0-rc4",
  "description": "Project Zomboid Server Manager - Web-based admin panel",
  "private": true,
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/itsmeares/better-zcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/itsmeares/better-zcp.git"
  },
  "bugs": {
    "url": "https://github.com/itsmeares/better-zcp/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"pnpm run server:dev\" \"pnpm run client:dev\"",
    "server:dev": "pnpm --filter @better-zcp/panel-server dev",
    "client:dev": "pnpm --filter @better-zcp/panel-client dev",
    "build": "pnpm --filter @better-zcp/panel-client build",
    "build:exe": "node scripts/release/build.mjs",
    "build:exe:windows": "node scripts/release/build.mjs --windows",
    "build:exe:linux": "node scripts/release/build.mjs --linux",
    "build:exe:all": "node scripts/release/build.mjs --all",
    "smoke:release": "node scripts/smoke-release.mjs",
    "check:client-boundary": "node scripts/check-client-boundary.mjs",
    "start": "pnpm --filter @better-zcp/panel-server start",
    "test": "pnpm run test:server && pnpm run test:client",
    "test:watch": "pnpm --filter @better-zcp/panel-server test:watch",
    "test:server": "pnpm --filter @better-zcp/panel-server test",
    "test:client": "pnpm --filter @better-zcp/panel-client test",
    "lint:server": "pnpm --filter @better-zcp/panel-server lint",
    "check:engine-signatures": "node scripts/check-engine-signatures.mjs",
    "gen:engine-signatures": "node scripts/gen-engine-signatures.mjs",
    "check:i18n-staleness": "node scripts/i18n-staleness-check.mjs",
    "check:bridge-actions": "node scripts/audit-bridge-actions.mjs .",
    "check:bridge-routes": "node scripts/audit-bridge-routes.mjs .",
    "check:rcon-commands": "node scripts/audit-rcon-commands.mjs .",
    "check:i18n": "node scripts/i18n-check.mjs --all",
    "prepare": "node .husky/install.mjs"
  },
  "lint-staged": {
    "*.{json,yml,yaml}": "prettier --ignore-unknown --write"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "archiver": "^7.0.1",
    "@yao-pkg/pkg": "^6.22.0",
    "concurrently": "^9.1.0",
    "esbuild": "^0.28.2",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "prettier": "3.9.6",
    "unzipper": "^0.12.5"
  },
  "overrides": {
    "esbuild": "$esbuild",
    "anymatch": {
      "picomatch": "2.3.2"
    },
    "readdirp": {
      "picomatch": "2.3.2"
    }
  }
}
